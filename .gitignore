# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local secrets
.token
system_prompt.txt
run_telegrambot.sh
.venv

# claude code
.claude/

# bkit 세션 텔레메트리(감사 로그·세션 기록) — 저장소에 올릴 것이 아니다
.bkit/

# playwright 브라우저 테스트 아티팩트(로그·스냅샷) — 저장소에 올릴 것이 아니다
.playwright-mcp/
store-assets/

# 안드로이드 서명 키와 TWA 빌드 산출물 — 저장소에 올릴 것이 아니다
*.jks
*.keystore
/twa/*
# 다음 릴리스에서 appVersionCode 를 올릴 자리다. 이건 남긴다(비밀 없음).
!/twa/twa-manifest.json
